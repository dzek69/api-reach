{
  "name": "api-reach",
  "version": "0.14.0-beta.14",
  "repository": "git@github.com:dzek69/api-reach.git",
  "author": "Jacek Nowacki @dzek69 <git-public@dzek.eu>",
  "license": "MIT",
  "scripts": {
    "test": "NODE_ENV=test jest",
    "docs": "typedoc src/index.ts --skipErrorChecking --out docs --includeVersion",
    "compile": "pnpm run compile:esm && pnpm run compile:cjs",
    "compile:esm": "rm -rf esm && tsc --project tsconfig.esm.json && node ./build-scripts/compile.esm.after.mjs",
    "compile:cjs": "rm -rf dist && tsc --project tsconfig.cjs.json && node ./build-scripts/compile.cjs.after.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "ezlint src",
    "lint:fix": "pnpm run lint --fix",
    "prepack": "pnpm run compile",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run docs",
    "start:dev": "nodemon",
    "start:dev:compatibility": "TS_NODE_FILES=true pnpm run start:dev",
    "start:httpbin": "docker run -p 9191:80 kennethreitz/httpbin",
    "prepare": "husky",
    "updates": "pnpm dlx npm-check-updates --dep prod",
    "updates:dev": "pnpm dlx npm-check-updates --dep dev",
    "updates:all": "pnpm dlx npm-check-updates"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    },
    "./node": {
      "require": "./dist/node.js",
      "types": "./esm/node.d.ts",
      "default": "./esm/node.js"
    },
    "./utils": {
      "require": "./dist/exportedUtils.js",
      "types": "./esm/exportedUtils.d.ts",
      "default": "./esm/exportedUtils.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./esm/index.d.ts",
  "module": "./esm/index.js",
  "type": "module",
  "dependencies": {
    "@ezez/errors": "^6.0.2",
    "@ezez/utils": "^4.9.1",
    "content-disposition": "^0.5.4",
    "mime-types": "^3.0.2",
    "oop-timers": "^5.2.1",
    "qs": "^6.15.3",
    "url-join": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@ezez/eslint": "^9.39.4",
    "@types/content-disposition": "^0.5.9",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/qs": "^6.15.1",
    "@types/url-join": "^4.0.0",
    "babel-plugin-module-extension": "^0.1.3",
    "fastify": "^5.12.0",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "keyv": "^5.6.0",
    "must": "^0.13.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "resolve-tspaths": "^0.8.23",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "node-fetch": "*"
  },
  "peerDependenciesMeta": {
    "node-fetch": {
      "optional": true
    }
  },
  "husky": {
    "hooks": {
      "pre-push": "pnpm run prepublishOnly && pnpm run compile"
    }
  },
  "libraryTemplate": {
    "version": "3.14.0",
    "language": "typescript",
    "fixDefaultForCommonJS": true,
    "jsx": false
  }
}
